# Copy to .env (never commit .env). The database is MongoDB Atlas.
NODE_ENV=development
PORT=4000
# Atlas: Connect -> Drivers -> copy the string, and add the database name (school_erp) before the "?"
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/school_erp?retryWrites=true&w=majority
# In production JWT_SECRET is mandatory (the server refuses to start without it). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
SESSION_HOURS=12
# The URL of the frontend (comma separated for several)
CORS_ORIGIN=http://localhost:5173
# Uploaded files live on disk (swap services/files.js for S3/GCS in production)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Signed download links expire after this many seconds
FILE_LINK_TTL=300
# Raise LOGIN_RATE_LIMIT only for scripted test runs
LOGIN_RATE_LIMIT=20
API_RATE_LIMIT=600
BCRYPT_ROUNDS=10
LOG_LEVEL=info

# ── Outgoing email (notifications and help desk) ─────────────────────────────
# Leave RESEND_API_KEY empty and nothing is ever emailed (in-app notifications still work).
# 1) Create a free account at resend.com  2) Domains -> Add domain (use a subdomain such as mail.yourdomain.com) and add the DNS records it shows
# 3) API Keys -> create one and paste it here. Never commit this file.
RESEND_API_KEY=
# The sender. Its domain must be the verified one from step 2.
MAIL_FROM=AtKaksha <noreply@mail.yourdomain.com>
# Where replies to notification emails go (your support inbox)
MAIL_REPLY_TO=support@yourdomain.com
# Who is emailed about new help desk tickets that schools send to the platform (defaults to MAIL_REPLY_TO)
MAIL_SUPPORT_TO=support@yourdomain.com
# Where people are told to report a sign-in code or password email they did not ask for (defaults to MAIL_REPLY_TO)
MAIL_SECURITY_TO=security@yourdomain.com
# Links in emails point here (defaults to the first CORS_ORIGIN)
APP_URL=http://localhost:5173
# Which notification categories are also emailed (the free Resend plan sends 100 a day, so keep this short)
MAIL_CATEGORIES=system,approvals,leave,fees,announcements,results,examination,helpdesk

# ── Online fee payment ──
# mock     a built-in test gateway that behaves like Razorpay but moves no money (the default outside production; needs no account)
# razorpay the real thing (fill the three RAZORPAY_ values below)
# off      online payment is hidden (the default in production)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# an unpaid order is closed after this many minutes; the most one online payment may be (rupees)
PAYMENT_ORDER_MINUTES=30
PAYMENT_MAX_AMOUNT=500000

# ── Uploaded files ──────────────────────────────────────────────────────────
# Leave these empty and files are kept in the database (GridFS). Fill all four and new files go to a PRIVATE Cloudflare R2 bucket
# (nothing is public: the app checks who may open a file, then streams it). FILE_STORE=gridfs forces the database even when R2 is set.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Seconds the school record, subscription and current academic year are kept in memory per server (default 20; 0 = always read the database)
# MEMO_SECONDS=20

# Keeps the host awake and the database warm. A monitor outside calls  https://<api address>/health/warm?key=<WARM_KEY>  every 5 minutes.
# A built-in key is used when this is empty (see src/core/config.js; the code is public, so it only keeps casual visitors away).
# For a private one:  openssl rand -hex 24   To switch the address off: WARM_KEY=off
# WARM_KEY=
